#!/bin/bash
# QA mode: a debug build of Vortex next to the user's own, isolated from it and driven by commands
# (App/docs/README.md). Names are 1-16 letters, digits or dashes, used in lowercase: A and a are one run.
#
#   scripts/qa build                               make build, then copy the app to build/qa/<run>/ (build/qa/latest)
#   scripts/qa start <name> [args…]                start the run <name> from that copy; waits until it listens
#   scripts/qa cmd <name> <command> [word|k=v…]    send a command, print the reply
#   scripts/qa stop <name>                         quit the run
#   scripts/qa kill <name>                         stop it at once, as a force quit: nothing is saved
#   scripts/qa reset <name>                        delete the run's data folder, only inside "Vortex QA"
#   scripts/qa list                                the runs, whether they run, and the app each runs
#
# cmd, stop, kill and reset refuse a run whose app comes from another checkout; --other-checkout before the
# subcommand allows it. Exit codes: 0 done, 1 an error reply or a refusal, 2 a timeout, 64 bad usage.
# QA_TIMEOUT bounds every wait (seconds, default 15); QA_APP=<path to Vortex.app> starts another make build copy.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd -P)
support="$HOME/Library/Application Support"
root="$support/Vortex QA"
timeout=${QA_TIMEOUT:-15}
bundle_id="io.github.ortexisartem.vortex.check"
channel_prefix="io.github.ortexisartem.vortex.qa."
other_checkout=0

# Posts a distributed notification: the name, then key=value or bare words (a word becomes word="").
read -r -d '' post_js <<'JS' || true
ObjC.import('Foundation');
function run(argv) {
  var info = $.NSMutableDictionary.alloc.init;
  for (var i = 1; i < argv.length; i++) {
    var eq = argv[i].indexOf('=');
    var key = eq < 0 ? argv[i] : argv[i].substring(0, eq);
    var value = eq < 0 ? '' : argv[i].substring(eq + 1);
    info.setObjectForKey($(value), $(key));
  }
  $.NSDistributedNotificationCenter.defaultCenter.postNotificationNameObjectUserInfoDeliverImmediately($(argv[0]), $(), info, true);
}
JS

die() {
  local code=$1
  shift
  echo "qa: $*" >&2
  exit "$code"
}

usage() {
  sed -n '5,15p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 64
}

# 1-16 letters, digits or dashes, in lowercase as the app keeps them; never something that looks like a QA option.
use_name() {
  name=$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')
  [[ "$name" =~ ^[a-z0-9-]{1,16}$ && "$name" != --qa* ]] || die 64 "a QA name is 1-16 letters, digits or dashes, not '${1:-}'"
  folder="$root/$name"
}

# Waits until the command succeeds, at most QA_TIMEOUT seconds.
wait_for() {
  local what=$1
  shift
  local deadline=$((SECONDS + timeout))
  until "$@"; do
    [ "$SECONDS" -lt "$deadline" ] || die 2 "timed out after ${timeout}s waiting for $what"
    sleep 0.1
  done
}

# Command lines of every process, never cut short. Read into a variable first: `ps | grep -q` fails under pipefail
# when grep stops early.
processes() {
  ps -axww -o command=
}

# Whether some process of Vortex runs as this run, with its name in any case.
run_process_exists() {
  local all
  all=$(processes)
  grep -qiE -- "/Contents/MacOS/Vortex .*--qa $name( |\$)" <<< "$all"
}

# The run's process id, when it runs: from its ready marker, and only if that process is this run of Vortex.
running_pid() {
  local marker="$folder/.qa/ready.json" pid command
  [ -f "$marker" ] || return 1
  pid=$(plutil -extract pid raw -o - "$marker" 2>/dev/null) || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  command=$(ps -ww -p "$pid" -o command= 2>/dev/null) || return 1
  grep -qiE -- "/Contents/MacOS/Vortex .*--qa $name( |\$)" <<< "$command" || return 1
  echo "$pid"
}

# The app the run runs now, from its ready marker or its process; else the one that ran last in its folder.
run_app() {
  local pid
  plutil -extract app raw -o - "$folder/.qa/ready.json" 2>/dev/null && return
  if pid=$(running_pid); then
    ps -ww -p "$pid" -o command= | sed -E 's#/Contents/MacOS/Vortex .*##'
    return
  fi
  cat "$folder/.qa/app" 2>/dev/null || true
}

# A run belongs to this checkout when its app is a copy inside it, or this checkout started it (QA_APP).
check_own_run() {
  local app
  app=$(run_app)
  [ "$other_checkout" = 1 ] && return 0
  [ -z "$app" ] && return 0
  case "$app" in "$repo"/*) return 0 ;; esac
  [ "$(cat "$folder/.qa/checkout" 2>/dev/null || true)" = "$repo" ] && return 0
  die 1 "the run $name runs $app, from another checkout: pick another name, or pass --other-checkout"
}

is_new_run() {
  local pid
  pid=$(running_pid) && [ "$pid" != "$1" ]
}

is_gone() {
  ! kill -0 "$1" 2>/dev/null
}

# Only a copy made by make build: a Debug build under a bundle id of its own, with QA mode in it. Anything else would
# start as plain Vortex, with the user's data and services.
check_app() {
  local id
  id=$(plutil -extract CFBundleIdentifier raw -o - "$1/Contents/Info.plist" 2>/dev/null || true)
  [ "$id" = "$bundle_id" ] || die 1 "$1 is not a make build copy (bundle id '$id'): QA runs only those"
  grep -rqF "$channel_prefix" "$1/Contents/MacOS" || die 1 "$1 has no QA mode: build this branch with scripts/qa build"
}

# Sends a command and prints the reply; the reply's ok decides the exit code.
send() {
  local command=$1
  shift
  for word in "$@"; do
    case "$word" in
      command=* | reply=*) die 64 "command= and reply= are taken by the script" ;;
    esac
  done
  local pid
  pid=$(running_pid) || die 1 "the run $name is not running: scripts/qa start $name"
  check_own_run
  local replies="$folder/.qa/replies"
  mkdir -p "$replies"
  local reply
  reply="$replies/$(uuidgen).json"
  osascript -l JavaScript -e "$post_js" "$channel_prefix$name" "command=$command" "reply=$reply" "$@" >/dev/null
  wait_for "the reply to $command" test -f "$reply"
  cat "$reply"
  echo
  local ok
  ok=$(plutil -extract ok raw -o - "$reply" 2>/dev/null || echo false)
  rm -f "$reply"
  [ "$ok" = true ] || exit 1
  case "$command" in
    relaunch) wait_for "the run $name to start again" is_new_run "$pid" ;;
    quit) wait_for "the run $name to quit" is_gone "$pid" ;;
  esac
}

cmd_build() {
  (cd "$repo" && make build)
  local product="$repo/build/DerivedData/Build/Products/Debug/Vortex.app"
  check_app "$product"
  local run
  run=$(date +%Y%m%d-%H%M%S)
  mkdir -p "$repo/build/qa/$run"
  ditto "$product" "$repo/build/qa/$run/Vortex.app"
  ln -sfn "$run" "$repo/build/qa/latest"
  # The three newest copies stay, and so does any copy a process still runs.
  local running
  running=$(processes)
  find "$repo/build/qa" -mindepth 1 -maxdepth 1 -type d -name '2*' | sort -r | tail -n +4 | while read -r old; do
    if grep -qF -- "$old/Vortex.app/Contents/MacOS/Vortex" <<< "$running"; then
      continue
    fi
    rm -rf -- "$old"
  done
  echo "$repo/build/qa/$run/Vortex.app"
}

cmd_start() {
  use_name "${1:-}"
  shift
  local app=${QA_APP:-"$repo/build/qa/latest/Vortex.app"}
  [ -d "$app" ] || die 1 "no copy at $app: run scripts/qa build"
  # The real path, so a newer build never changes the app under the run.
  app=$(cd "$app" && pwd -P)
  check_app "$app"
  if pid=$(running_pid) || run_process_exists; then
    die 1 "the run $name runs already (${pid:+pid $pid, }app $(run_app)): pick another name"
  fi
  mkdir -p "$folder/.qa"
  rm -f "$folder/.qa/ready.json"
  echo "$repo" > "$folder/.qa/checkout"
  local log="$folder/.qa/launch.log"
  : > "$log"
  # In the background (-g), as a new process of its own through LaunchServices (-n); what it says on standard error,
  # such as why it refused to start, lands in the log.
  open -n -g --stderr "$log" -a "$app" --args --qa "$name" "$@"
  local deadline=$((SECONDS + timeout)) started=$SECONDS seen=0
  until running_pid >/dev/null; do
    # Gone after it was seen, or never seen in 3 s: it refused to start. Its last words may take a moment to land.
    if run_process_exists; then
      seen=1
    elif [ "$seen" = 1 ] || [ $((SECONDS - started)) -ge 3 ]; then
      sleep 0.5
      cat "$log" >&2
      die 1 "the run $name did not start"
    fi
    [ "$SECONDS" -lt "$deadline" ] || die 2 "timed out after ${timeout}s waiting for the run $name to start"
    sleep 0.1
  done
  echo "started $name: pid $(running_pid), app $app, data in $folder"
}

cmd_stop() {
  use_name "${1:-}"
  if ! running_pid >/dev/null; then
    echo "the run $name is not running"
    return
  fi
  send quit >/dev/null
  echo "stopped $name"
}

cmd_kill() {
  use_name "${1:-}"
  local pid
  pid=$(running_pid) || die 1 "the run $name is not running"
  check_own_run
  kill -9 "$pid"
  wait_for "the run $name to end" is_gone "$pid"
  echo "killed $name (pid $pid)"
}

cmd_reset() {
  use_name "${1:-}"
  if running_pid >/dev/null || run_process_exists; then
    die 1 "the run $name runs: scripts/qa stop $name first"
  fi
  if [ ! -e "$folder" ] && [ ! -L "$folder" ]; then
    echo "nothing to delete for $name"
    return
  fi
  # Only a real folder right inside the real "Vortex QA", which itself sits right in Application Support: no link
  # anywhere may lead the deletion elsewhere, such as into the user's Vortex folder.
  local real_support real_root real
  real_support=$(cd "$support" && pwd -P)
  real_root=$(cd "$root" && pwd -P)
  [ "$real_root" = "$real_support/Vortex QA" ] || die 1 "$root leads to $real_root: nothing deleted"
  [ ! -L "$folder" ] || die 1 "$folder is a link: nothing deleted"
  real=$(cd "$folder" && pwd -P)
  [ "$real" = "$real_root/$name" ] || die 1 "$folder leads to $real: nothing deleted"
  check_own_run
  rm -rf -- "$real"
  echo "deleted $real"
}

cmd_list() {
  [ -d "$root" ] || return 0
  local entry pid
  for entry in "$root"/*; do
    [[ -d "$entry" && "$(basename "$entry")" =~ ^[a-z0-9-]{1,16}$ ]] || continue
    use_name "$(basename "$entry")"
    if pid=$(running_pid); then
      echo "$name: running, pid $pid, app $(run_app)"
    else
      echo "$name: not running, last app $(run_app)"
    fi
  done
}

if [ "${1:-}" = "--other-checkout" ]; then
  other_checkout=1
  shift
fi
case "${1:-}" in
  build) cmd_build ;;
  start) shift; [ $# -ge 1 ] || usage; cmd_start "$@" ;;
  cmd) shift; [ $# -ge 2 ] || usage; use_name "$1"; shift; send "$@" ;;
  stop) [ $# -eq 2 ] || usage; cmd_stop "$2" ;;
  kill) [ $# -eq 2 ] || usage; cmd_kill "$2" ;;
  reset) [ $# -eq 2 ] || usage; cmd_reset "$2" ;;
  list) cmd_list ;;
  *) usage ;;
esac
