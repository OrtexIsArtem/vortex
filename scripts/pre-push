#!/bin/sh
# Before every push: the no-network check and the package tests. Installed by `make hooks`.
set -eu
cd "$(git rev-parse --show-toplevel)"
./scripts/check-no-network.sh
# In a linked worktree git hands the hook GIT_DIR and the like, which would send SwiftPM's own git to this repository.
unset $(git rev-parse --local-env-vars)
swift test --package-path Packages --quiet
