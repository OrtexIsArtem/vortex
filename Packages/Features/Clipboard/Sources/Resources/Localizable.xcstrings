          }
        }
      }
    },
    "Copy text, a link, an image or files, and it appears here." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопіюйте текст, посилання, зображення чи файли — вони з’являться тут."
