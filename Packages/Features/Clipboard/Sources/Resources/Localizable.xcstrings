      "comment" : "Keep history: one of the times",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тиждень"
          }
        }
      }
    },
    "A year" : {
      "comment" : "Keep history: one of the times",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рік"
          }
        }
      }
    },
    "Add app" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додати програму"
          }
        }
      }
    },
    "and %lld more" : {
      "comment" : "Under the first file name of a copy with several files",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "і ще %lld"
          }
        }
      }
    },
    "Clear" : {
      "comment" : "Removes all items except pinned ones",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистити"
          }
        }
      }
    },
    "Clear search" : {
      "comment" : "The button that empties the search field",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистити пошук"
          }
        }
      }
    },
    "Clipboard" : {
      "comment" : "Feature name in the sidebar, settings and the tab header",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буфер обміну"
          }
        }
      }
    },
    "Clipboard history and pinned items." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історія буфера обміну й закріплені елементи."
          }
        }
      }
    },
    "Copied" : {
      "comment" : "Shown for a moment after a card is clicked",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопійовано"
          }
        }
      }
    },
    "Copies it again" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копіює знову"
          }
        }
      }
    },
    "Copy" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопіювати"
          }
        }
      }
    },
    "Copy text, a link, an image or files, and it appears here." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопіюйте текст, посилання, зображення чи файли — вони зʼявляться тут."
          }
        }
      }
    },
    "Delete" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалити"
          }
        }
      }
    },
    "Everything you copied, searchable" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе скопійоване, з пошуком"
          }
        }
      }
    },
    "Forever" : {
      "comment" : "Keep history: never removed by age (macOS Messages says «Завжди»)",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завжди"
          }
        }
      }
    },
    "Hidden item" : {
      "comment" : "VoiceOver label of a password kept hidden",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прихований елемент"
          }
        }
      }
    },
    "Hide" : {
      "comment" : "Hides a revealed password",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сховати"
          }
        }
      }
    },
    "History" : {
      "comment" : "Settings row: how many items the clipboard history holds and their size",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історія"
          }
        }
      }
    },
    "History cleared" : {
      "comment" : "Undo toast after Clear",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історію очищено"
          }
        }
      }
    },
    "Ignored apps" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ігноровані програми"
          }
        }
      }
    },
    "Image" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зображення"
          }
        }
      }
    },
    "Image %@ at %@" : {
      "comment" : "File name of a copied image: the date and the time",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зображення %@ о %@"
          }
        }
      }
    },
    "Keep history" : {
      "comment" : "Settings › Features › Clipboard: how long copies stay in the history",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігати історію"
          }
        }
      }
    },
    "Keeps what you copy for a week, a month or as long as you choose. Search finds text, links and even the words in a screenshot. Pin what you reuse." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігає скопійоване тиждень, місяць або скільки захочете. Пошук знаходить текст, посилання і навіть слова на знімку екрана. Закріплюйте те, що використовуєте знову."
          }
        }
      }
    },
    "Keeps your clipboard history." : {
      "comment" : "Why the clipboard needs Paste from Other Apps, next to the permission",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігає історію буфера обміну."
          }
        }
      }
    },
    "Not found" : {
      "comment" : "The copied file was deleted or moved",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не знайдено"
          }
        }
      }
    },
    "Nothing copied in these apps is kept. Passwords marked secret are shown hidden and kept only until Vortex quits." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопійоване в цих програмах не зберігається. Паролі, позначені як секретні, показуються прихованими й зберігаються лише до завершення роботи Vortex."
          }
        }
      }
    },
    "Nothing copied yet" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще нічого не скопійовано"
          }
        }
      }
    },
    "Nothing found" : {
      "comment" : "The clipboard tab when the search matches nothing",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нічого не знайдено"
          }
        }
      }
    },
    "Older items removed" : {
      "comment" : "Undo toast after a shorter Keep history",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Старіші елементи вилучено"
          }
        }
      }
    },
    "Other…" : {
      "comment" : "Picks an app in /Applications to ignore",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інша…"
          }
        }
      }
    },
    "Pin" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закріпити"
          }
        }
      }
    },
    "Pinned items stay. The history holds at most 10,000 items and 1 GB; past that the oldest pictures go first." : {
      "comment" : "Caption of Keep history",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закріплені елементи лишаються. Історія вміщує щонайбільше 10 000 елементів і 1 ГБ; понад це першими зникають найстаріші зображення."
          }
        }
      }
    },
    "Release to copy" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відпустіть, щоб скопіювати"
          }
        }
      }
    },
    "Remove" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вилучити"
          }
        }
      }
    },
    "Removes everything except pinned items" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вилучає все, крім закріпленого"
          }
        }
      }
    },
    "Search" : {
      "comment" : "Placeholder of the search field in the clipboard tab",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пошук"
          }
        }
      }
    },
    "Show" : {
      "comment" : "Reveals a hidden password",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показати"
          }
        }
      }
    },
    "Show in Finder" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показати у Finder"
          }
        }
      }
    },
    "Undo" : {
      "comment" : "Takes Clear or a shorter Keep history back",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відмінити"
          }
        }
      }
    },
    "Unpin" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкріпити"
          }
        }
      }
    }
  },
  "version" : "1.0"
