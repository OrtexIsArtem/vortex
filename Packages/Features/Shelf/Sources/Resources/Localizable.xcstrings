      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показати у Finder"
          }
        }
      }
    },
    "Stop watching" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
