{
  "sourceLanguage" : "en",
  "strings" : {
    "Add folder…" : {
      "comment" : "Opens the folder picker to watch a folder",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додати папку…"
          }
        }
      }
    },
    "Clear" : {
      "comment" : "Takes all items off the shelf except pinned ones",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистити"
          }
        }
      }
    },
    "Drop files here" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Киньте файли сюди"
          }
        }
      }
    },
    "Drop here" : {
      "comment" : "Last tile of the shelf grid",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Киньте сюди"
          }
        }
      }
    },
    "every file" : {
      "comment" : "Placeholder of an empty file types field",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "усі файли"
          }
        }
      }
    },
    "File types" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типи файлів"
          }
        }
      }
    },
    "File types, separated by commas; empty takes every file" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типи файлів через кому; порожнє поле — усі файли"
          }
        }
      }
    },
    "Folder" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка"
          }
        }
      }
    },
    "Folder, a build file or …/last_builds/*.aab" : {
      "comment" : "Placeholder of the field for a path to watch",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка, файл збірки або …/last_builds/*.aab"
          }
        }
      }
    },
    "New files from %@ appear here by themselves." : {
      "comment" : "%@ lists watched folder names",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові файли з %@ з’являться тут самі."
          }
        }
      }
    },
    "New files in it land on the shelf by themselves, for example builds" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові файли з неї самі потраплятимуть на полицю, наприклад збірки"
          }
        }
      }
    },
    "New files of the right type land on the shelf once they are fully written, and the notch flashes." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові файли потрібних типів потрапляють на полицю, щойно повністю запишуться, а виріз блимає."
          }
        }
      }
    },
    "Not found" : {
      "comment" : "The file was deleted or moved",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не знайдено"
          }
        }
      }
    },
    "Nothing is at %@." : {
      "comment" : "The typed path does not exist",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За шляхом %@ нічого немає."
          }
        }
      }
    },
    "Or on the menu bar icon. The shelf keeps links to your files and clears itself after 24 hours." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Або на значок у рядку меню. Полиця зберігає посилання на файли й очищується сама через 24 години."
          }
        }
      }
    },
    "Path to watch" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шлях для стеження"
          }
        }
      }
    },
    "Pin" : {
      "comment" : "Pinned items stay on the shelf past 24 hours",
