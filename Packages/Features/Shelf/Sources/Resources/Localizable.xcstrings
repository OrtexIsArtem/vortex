            "value" : "Змінити…"
          }
        }
      }
    },
    "Choose…" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибрати…"
          }
        }
      }
    },
    "Clear" : {
      "comment" : "Takes all items off the shelf except pinned ones",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистити"
          }
        }
      }
    },
    "Drop files here" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Киньте файли сюди"
          }
        }
      }
    },
    "Drop here" : {
      "comment" : "Last tile of the shelf grid",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Киньте сюди"
          }
        }
      }
    },
    "Extensions separated by commas; leave empty to take every file." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розширення через кому; залиште порожнім, щоб брати всі файли."
          }
        }
      }
    },
    "File types" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типи файлів"
          }
        }
      }
    },
    "Folder" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка"
          }
        }
      }
    },
    "New files in it land on the shelf once they are fully written, and the notch flashes." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові файли з неї потрапляють на полицю, щойно повністю запишуться, а виріз блимає."
          }
        }
      }
    },
    "Not found" : {
      "comment" : "The file was deleted or moved",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не знайдено"
          }
        }
      }
    },
    "Or on the menu bar icon. The shelf keeps links to your files and clears itself after 24 hours." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Або на значок у рядку меню. Полиця зберігає посилання на файли й очищується сама через 24 години."
          }
        }
      }
    },
    "Pin" : {
      "comment" : "Pinned items stay on the shelf past 24 hours",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закріпити"
          }
        }
      }
    },
    "Quick Look" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидкий перегляд"
          }
        }
      }
    },
    "Release to put it on the shelf" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відпустіть, щоб покласти на полицю"
          }
        }
      }
    },
    "Remove from the shelf" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прибрати з полиці"
          }
        }
      }
    },
    "Shelf" : {
      "comment" : "Feature name in the sidebar, settings and the tab header",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полиця"
          }
        }
      }
    },
