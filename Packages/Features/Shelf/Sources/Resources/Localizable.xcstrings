{
  "sourceLanguage" : "en",
  "strings" : {
    "Add a color" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додати колір"
          }
        }
      }
    },
    "Add folder…" : {
      "comment" : "Opens the folder picker to watch a folder",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додати папку…"
          }
        }
      }
    },
    "Back to blue and green" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повернути блакитний і зелений"
          }
        }
      }
    },
    "Clear" : {
      "comment" : "Takes all items off the shelf except pinned ones",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистити"
          }
        }
      }
    },
    "Color %lld" : {
      "comment" : "VoiceOver name of the flash color for the n-th new file",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Колір %lld"
          }
        }
      }
    },
    "Drop files here" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть файли сюди"
          }
        }
      }
    },
    "Drop here" : {
      "comment" : "Last tile of the shelf grid",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть сюди"
          }
        }
      }
    },
    "every file" : {
      "comment" : "Placeholder of an empty file types field",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "усі файли"
          }
        }
      }
    },
    "File types" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типи файлів"
          }
        }
      }
    },
    "File types, separated by commas; empty takes every file" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типи файлів через кому; порожнє поле — усі файли"
          }
        }
      }
    },
    "Folder" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка"
          }
        }
      }
    },
    "Folder, a build file or …/last_builds/*.aab" : {
      "comment" : "Placeholder of the field for a path to watch",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка, файл збірки або …/last_builds/*.aab"
          }
        }
      }
    },
    "Image %@ at %@" : {
      "comment" : "File name of an image dropped without a file: the date and the time",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зображення %@ о %@"
          }
        }
      }
    },
    "New" : {
      "comment" : "VoiceOver value of a shelf item that came by itself and still has its dot, read before its size and age",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новий"
          }
        }
      }
    },
    "New files flash the notch: color 1 for the first new file, color 2 for the second, and so on; after the last color, white. A file on the shelf stops being new once you point at it." : {
      "comment" : "Caption of the notch flash colors in the shelf's settings; a new file keeps its dot until the pointer comes over it",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли надходять нові файли, виріз блимає: кольором 1 — для першого нового файлу, кольором 2 — для другого і так далі, а після останнього кольору — білим. Файл на полиці перестає бути новим, щойно ви наведете на нього вказівник."
          }
        }
      }
    },
    "New files from %@ appear here by themselves." : {
      "comment" : "On the empty shelf, with one watched folder: %@ is its name as Finder shows it",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові файли з папки «%@» зʼявляться тут самі."
          }
        }
      }
    },
    "New files from these folders appear here by themselves: %@." : {
      "comment" : "On the empty shelf, with several watched folders: %@ lists their names as Finder shows them",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові файли з цих папок зʼявляться тут самі: %@."
          }
        }
      }
    },
    "New files in it land on the shelf by themselves, for example builds" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові файли з неї самі потраплятимуть на полицю, наприклад збірки"
          }
        }
      }
    },
    "New files of the right type land on the shelf once they are fully written, and the notch flashes." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові файли потрібних типів потрапляють на полицю, щойно повністю запишуться, а виріз блимає."
          }
        }
      }
    },
    "Not found" : {
      "comment" : "The file was deleted or moved",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не знайдено"
          }
        }
      }
    },
    "Notch flash" : {
      "comment" : "Settings: colors of the notch flash for new files",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Блимання вирізу"
          }
        }
      }
    },
    "Nothing is at %@." : {
      "comment" : "The typed path does not exist",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За шляхом %@ нічого немає."
          }
        }
      }
    },
    "Path to watch" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Шлях для стеження"
          }
        }
      }
    },
    "Pin" : {
      "comment" : "Pinned items stay on the shelf past 24 hours",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закріпити"
          }
        }
      }
    },
    "Plays the flashes in 3 seconds: close the window to watch the notch" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покаже блимання через 3 с: закрийте вікно, щоб бачити виріз"
          }
        }
      }
    },
    "Quick Look" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Швидкий перегляд"
          }
        }
      }
    },
    "Release to put it on the shelf" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відпустіть, щоб покласти на полицю"
          }
        }
      }
    },
    "Remove from the shelf" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вилучити з полиці"
          }
        }
      }
    },
    "Remove the last color" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вилучити останній колір"
          }
        }
      }
    },
    "Reset" : {
      "comment" : "Puts the default flash colors back",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скинути"
          }
        }
      }
    },
    "Shelf" : {
      "comment" : "Feature name in the sidebar, settings and the tab header",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полиця"
          }
        }
      }
    },
    "Show in Finder" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показати у Finder"
          }
        }
      }
    },
    "Stop watching" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не стежити"
          }
        }
      }
    },
    "Takes everything off the shelf except pinned items" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знімає з полиці все, крім закріпленого"
          }
        }
      }
    },
    "Test" : {
      "comment" : "Plays the notch flashes three seconds later",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірити"
          }
        }
      }
    },
    "Unpin" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкріпити"
          }
        }
      }
    },
    "Unpinned items leave the shelf after 24 hours." : {
      "comment" : "Under «Drop files here» on the empty shelf",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Незакріплені файли зникають із полиці через 24 години."
          }
        }
      }
    },
    "Watch" : {
      "comment" : "Starts watching the typed path",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стежити"
          }
        }
      }
    },
    "Watch a folder…" : {
      "comment" : "Button on the empty shelf: opens the folder picker",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стежити за папкою…"
          }
        }
      }
    },
    "Watched folders" : {
      "comment" : "New files from these folders land on the shelf",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відстежувані папки"
          }
        }
      }
