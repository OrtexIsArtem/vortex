        }
      }
    },
    "Where Claude reaches Vortex on this Mac, at 127.0.0.1. After a change, connect Claude Code again." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Де Claude знаходить Vortex на цьому Mac, за адресою 127.0.0.1. Після зміни під'єднай Claude Code заново."
          }
        }
      }
    },
    "You can do this later in the Keys tab." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
