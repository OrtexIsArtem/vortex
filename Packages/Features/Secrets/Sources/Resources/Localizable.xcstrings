{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ wants to use %@" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ хоче скористатися %@"
          }
        }
      }
    },
    "1 hour" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 година"
          }
        }
      }
    },
    "A key by this name is there already." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ із такою назвою вже є."
          }
        }
      }
    },
    "A name has letters, digits, dots, dashes or underscores, and no spaces." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У назві — латинські літери, цифри, крапки, дефіси чи підкреслення, без пробілів."
          }
        }
      }
    },
    "Add one with +: Claude uses it by its name and never sees its value." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додай ключ кнопкою +: Claude користуватиметься ним за назвою й ніколи не побачить значення."
          }
        }
      }
    },
