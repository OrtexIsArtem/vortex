          }
        }
      }
    },
    "Vortex could not listen on port %@: %@. Pick another port in Settings › Features › Keys." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vortex не зміг відкрити порт %@: %@. Обери інший порт у Налаштування › Фічі › Ключі."
          }
        }
      }
    },
    "Waiting for Claude on port %@. Connect Claude Code once with the command." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
