    "Add" : {
      "comment" : "The editor's panel: puts the widget on Home where its copy shows",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додати"
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "The editor's panel: ends editing Home and puts it back as it was when the editor opened",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скасувати"
          }
        }
      }
    },
    "Clear search" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистити пошук"
          }
        }
      }
    },
    "Done" : {
      "comment" : "The editor's panel: ends editing Home",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готово"
          }
        }
      }
    },
    "Edit Home" : {
      "comment" : "The pencil in Home's corner, Home's right-click menu and the empty Home's button: Home turns into the editor",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змінити головну"
          }
        }
      }
    },
    "Home" : {
      "comment" : "Feature name in the sidebar and settings",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Головна"
          }
        }
      }
    },
    "Home lays out the widgets of the features you added, with your utilities at the end of its top row." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Головна показує віджети доданих функцій, а в кінці верхнього рядка — ваші утиліти."
          }
        }
      }
    },
    "In the notch row" : {
      "comment" : "The editor's panel: the feature's widget is in the row next to the notch",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У рядку біля вирізу"
          }
        }
      }
    },
    "More" : {
      "comment" : "The editor's panel: the features with widgets, none of them on Home",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інші"
          }
        }
      }
    },
    "More widgets in Features" : {
      "comment" : "The editor's panel: opens the catalog of features",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Більше віджетів у Функціях"
          }
        }
      }
    },
    "No room" : {
      "comment" : "The editor's panel: the widget's size fits nowhere on Home",
