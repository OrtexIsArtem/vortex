    "Plays the sound and the flashes in 3 seconds: close the window to watch the notch, point at it to stop them" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програє звук і блимання через 3 с: закрийте вікно, щоб бачити виріз, і наведіть на нього, щоб зупинити"
          }
        }
      }
    },
