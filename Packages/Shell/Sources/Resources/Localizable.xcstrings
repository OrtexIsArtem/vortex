    "Checked after restart" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Буде перевірено після перезапуску"
          }
        }
      }
    },
    "Choose your features" : {
      "comment" : "Onboarding: the Features page's title",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть функції"
          }
        }
      }
    },
    "Click Allow in the notification at the top right, or in Notification Center." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натисніть «Дозволити» у сповіщенні вгорі праворуч або в Центрі сповіщень."
          }
        }
      }
    },
    "Click the notch to open Vortex, or click its icon in the menu bar." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть виріз, щоб відкрити Vortex, або клацніть його значок на смузі меню."
          }
        }
      }
    },
    "Click the notch to open Vortex, or press %@." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть виріз, щоб відкрити Vortex, або натисніть %@."
          }
        }
      }
    },
    "Click the notch to open Vortex." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацніть виріз, щоб відкрити Vortex."
          }
        }
      }
    },
    "Click Vortex's icon in the menu bar to open it." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
