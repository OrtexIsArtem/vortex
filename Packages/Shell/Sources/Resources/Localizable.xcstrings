      }
    },
    "Delay" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затримка"
          }
        }
      }
    },
    "Don't ask again" : {
      "comment" : "Checkbox of the alert that offers to move Vortex to the Applications folder",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Більше не питати"
          }
        }
      }
    },
    "Don't press Touch ID: it locks your Mac, and Vortex can't block it." : {
      "comment" : "Tooltip of the Touch ID button drawn on the keyboard cleaning screen.",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не натискайте Touch ID: він замикає Mac, і Vortex не може його заблокувати."
          }
        }
      }
    },
    "Drag Vortex to the Applications folder in Finder." : {
      "comment" : "Text of the alert after moving Vortex to the Applications folder failed",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть Vortex у папку «Програми» у Finder."
          }
        }
      }
    },
    "Erase %@ data?" : {
      "comment" : "Erase confirmation title; the argument is the feature's name",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стерти дані «%@»?"
          }
        }
      }
    },
    "Erase and Restart" : {
      "comment" : "Erase confirmation: confirms",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стерти й перезапустити"
          }
        }
      }
    },
    "Erase Data…" : {
      "comment" : "Feature page of a removed feature: erases what it keeps",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стерти дані…"
          }
        }
      }
    },
    "Everything is added" : {
      "comment" : "Catalog: nothing left to add",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе додано"
          }
        }
      }
    },
    "Everything is built into Vortex and works offline. Add what you need, remove what you don't." : {
      "comment" : "Catalog: the line under its title",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усе вбудовано у Vortex і працює без мережі. Додайте потрібне, приберіть зайве."
          }
        }
      }
    },
    "Features" : {
      "comment" : "Settings section",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Функції"
          }
        }
      }
    },
    "Features you add with settings show them here" : {
      "comment" : "Settings › Features while no running feature has anything to set",
