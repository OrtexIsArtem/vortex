{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ removed" : {
      "comment" : "Undo toast; the argument is the feature's name",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» прибрано"
          }
        }
      }
    },
    "%@ s" : {
      "comment" : "Delay in seconds, e.g. 0.3 s",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ с"
          }
        }
      }
    },
    "%lld of %lld features chosen" : {
      "comment" : "Onboarding: the Features page's footer",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибрано функцій: %1$lld з %2$lld"
          }
        }
      }
    },
    "About %@" : {
      "comment" : "A sidebar icon's menu: opens the feature's page; the argument is its name",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Про «%@»"
          }
        }
      }
    },
    "Activation" : {
      "comment" : "Settings section: how the window opens and closes",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виклик"
          }
        }
      }
