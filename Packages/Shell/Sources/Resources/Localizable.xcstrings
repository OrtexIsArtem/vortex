    "Opens and closes Vortex from anywhere." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриває й закриває Vortex будь-де."
          }
        }
      }
    },
    "Opens the latest release in your browser. Vortex itself never goes online." : {
