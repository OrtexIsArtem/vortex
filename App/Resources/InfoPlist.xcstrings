    "NSAppleEventsUsageDescription" : {
      "comment" : "Shown by macOS when Vortex first asks to read the page open in a browser",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vortex saves the address of the page open in your browser with a task."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vortex зберігає адресу сторінки, відкритої в браузері, разом із завданням."
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription" : {
      "comment" : "Shown by macOS when Vortex first reads a file in the Desktop folder",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vortex shows the files you put on its shelf or copy, and puts new files from watched folders on the shelf."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vortex показує файли, які ви кладете на полицю чи копіюєте, і кладе на полицю нові файли з відстежуваних папок."
          }
        }
      }
    },
