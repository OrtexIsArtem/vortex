// Copy this file to Config/Local.xcconfig (git ignores it) to sign your builds with your own team.
// Left as is, every line is a comment and builds are signed ad hoc.

// Your Apple developer team ID. A free Personal Team works. CONTRIBUTING.md shows how to find it.
// DEVELOPMENT_TEAM = ABCDE12345

// A bundle id of your own, only if Xcode says this one belongs to another team.
// The `vortex` command (Tools/CLI) opens the default bundle id, so it won't reach a build with another one.
// PRODUCT_BUNDLE_IDENTIFIER = com.example.vortex
