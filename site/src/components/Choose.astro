---
// Only what you need: the features a visitor chooses and changes, as the README's "Features and Home" and the
// catalog's docs (Packages/Shell/docs/catalog.md) say. The demo window's puzzle piece leads here.
import { copyFor } from '../copy';
import { appLangOf, headingGap, localeOf } from '../copy/locales';
import Icon from './Icon.astro';

const copy = copyFor(Astro.url);
const gap = headingGap(Astro.url.pathname);
// The label is the catalog's name in the app, in the app's language, as a chapter's is its tab's.
const appLang = appLangOf(localeOf(Astro.url.pathname));

const c = copy.choose;
---

<section class="section choose" id="choose" aria-labelledby="choose-title">
  <div class="container choose__grid">
    <div class="choose__copy" data-reveal>
      <p class="choose__label" lang={appLang}><Icon name="puzzle" size={15} />{c.label}</p>
      <h2 class="h2" id="choose-title">{c.title}{gap}<span>{c.titleQuiet}</span></h2>
      <p class="lead">{c.body}</p>
    </div>
    <dl class="choose__facts" data-reveal="later">
      {
        c.facts.map((fact) => (
          <div class="choose__fact">
            <dt>{fact.label}</dt>
            <dd>{fact.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .choose__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
    gap: 40px var(--gutter);
  }

  .choose__copy {
    grid-column: 1 / span 6;
  }

  .choose__facts {
    grid-column: 7 / span 6;
    margin: 0;
  }

  .choose__label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 20px;
    color: var(--text-2);
    font: 500 13px/1 var(--mono);
  }

  /* As Privacy's facts: a quiet label in mono, the fact beside it. */
  .choose__fact {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 16px;
    padding: 13px 0;
    box-shadow: inset 0 var(--hair) 0 var(--line);
  }

  .choose__fact:last-child {
    box-shadow:
      inset 0 var(--hair) 0 var(--line),
      inset 0 calc(var(--hair) * -1) 0 var(--line);
  }

  .choose__fact dt {
    color: var(--text-3);
    font: 12.5px/1.6 var(--mono);
  }

  .choose__fact dd {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (max-width: 1023px) {
    .choose__copy,
    .choose__facts {
      grid-column: 1 / -1;
    }

    .choose__facts {
      max-width: 620px;
    }
  }

  @media (max-width: 599px) {
    .choose__fact {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
