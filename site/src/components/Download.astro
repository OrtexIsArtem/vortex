---
// Getting Vortex, as the README's Install says it: the download, opening an app that isn't notarized, and the
// permissions, every one optional. On a phone, where it can't run, the visitor sends the link to their Mac instead.
import { copyFor } from '../copy';
import { headingGap } from '../copy/locales';
import { appVersion, downloadUrl, repoUrl } from '../lib/app';
import { githubMark } from '../lib/icons';
import CopyCommand from './CopyCommand.astro';
import Icon from './Icon.astro';

interface Props {
  /** On a guide: its feature's demo on the landing, offered beside the download. */
  demo?: { href: string; label: string } | undefined;
}

const { demo } = Astro.props;
const copy = copyFor(Astro.url);
const gap = headingGap(Astro.url.pathname);

const d = copy.download;
---

<section class="section dl" id="download" aria-labelledby="dl-title">
  <div class="container">
    <div class="dl__head" data-reveal>
      <h2 class="h2" id="dl-title">{d.title}{gap}<span>{d.titleQuiet}</span></h2>
      <div class="dl__mac">
        {
          demo ? (
            <div class="dl__actions">
              <a class="btn btn--primary dl__button" href={downloadUrl} data-page-action>
                <Icon name="download" size={18} />
                {d.button(appVersion)}
              </a>
              <a class="btn btn--quiet dl__button" href={demo.href}>
                {demo.label}
              </a>
            </div>
          ) : (
            <a class="btn btn--primary dl__button" href={downloadUrl} data-page-action>
              <Icon name="download" size={18} />
              {d.button(appVersion)}
            </a>
          )
        }
        <p class="dl__meta">{d.meta(appVersion)}</p>
      </div>
      <div class="dl__phone">
        <p class="dl__phone-note">{d.phone.note}</p>
        <div class="dl__phone-actions">
          <button class="btn btn--primary" type="button" data-share data-page-action>
            <Icon name="share" size={17} />
            <span data-share-label>{d.phone.share}</span>
          </button>
          {
            demo ? (
              <a class="btn btn--quiet" href={demo.href}>
                {demo.label}
              </a>
            ) : (
              <a class="btn btn--quiet" href={repoUrl}>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d={githubMark}></path></svg>
                {copy.hero.star}
              </a>
            )
          }
        </div>
      </div>
    </div>

    <div class="dl__grid">
      <div class="dl__card" data-reveal>
        <h3 class="dl__title">{d.firstTitle}</h3>
        <ol class="dl__steps">
          {d.steps.map((step) => <li>{step}</li>)}
        </ol>
        <p class="dl__or">{d.terminal}</p>
        <CopyCommand lines={[d.xattr]} />
      </div>
      <div class="dl__card" data-reveal="later">
        <h3 class="dl__title">{d.permissionsTitle}</h3>
        <dl class="dl__perms">
          {
            d.permissions.map((permission) => (
              <div class="dl__perm">
                <dt>{permission.name}</dt>
                <dd>{permission.use}</dd>
              </div>
            ))
          }
        </dl>
        <p class="dl__note">{d.permissionsNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .dl__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .dl__head .h2 {
    max-width: 760px;
  }

  .dl__mac,
  .dl__phone {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 36px 0 0;
  }

  .dl__button {
    height: 56px;
    padding: 0 30px;
    font-size: 16px;
  }

  .dl__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .dl__meta {
    margin: 16px 0 0;
    color: var(--text-3);
    font: 12.5px var(--mono);
  }

  /* A phone can't run Vortex: it gets the way to send the link to a Mac. */
  .dl__phone {
    display: none;
  }

  .dl__phone-note {
    max-width: 340px;
    margin: 0;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.5;
  }

  .dl__phone-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 22px 0 0;
  }

  @media (hover: none) and (pointer: coarse) {
    .dl__mac {
      display: none;
    }

    .dl__phone {
      display: flex;
    }
  }

  .dl__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 64px 0 0;
  }

  .dl__card {
    padding: 30px;
    border-radius: 24px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05);
  }

  .dl__title {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* A real sequence, so it is numbered. */
  .dl__steps {
    margin: 20px 0 0;
    padding: 0;
    counter-reset: step;
    list-style: none;
  }

  .dl__steps li {
    position: relative;
    padding: 0 0 0 40px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.55;
    counter-increment: step;
  }

  .dl__steps li + li {
    margin-top: 14px;
  }

  .dl__steps li::before {
    content: counter(step);
    position: absolute;
    top: -1px;
    left: 0;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--track);
    color: var(--text-1);
    font: 12px var(--mono);
  }

  .dl__or {
    margin: 22px 0 10px;
    color: var(--text-3);
    font-size: 13.5px;
  }

  .dl__perms {
    margin: 14px 0 0;
  }

  .dl__perm {
    padding: 12px 0;
    box-shadow: inset 0 calc(var(--hair) * -1) 0 var(--line);
  }

  .dl__perm dt {
    font-size: 15px;
    font-weight: 500;
  }

  .dl__perm dd {
    margin: 3px 0 0;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.45;
  }

  .dl__note {
    margin: 16px 0 0;
    color: var(--text-3);
    font-size: 13.5px;
    line-height: 1.5;
  }

  @media (max-width: 1023px) {
    .dl__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 599px) {
    .dl__grid {
      margin-top: 44px;
    }

    .dl__card {
      padding: 22px;
    }
  }
</style>

<script>
  import { copy } from '../scripts/copy';

  // The share sheet sends the page to a Mac (AirDrop, Messages, Mail); without one, the link is copied instead. Here
  // and in the hero, on phones.
  const p = copy.download.phone;
  document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((button) => {
    const label = button.querySelector<HTMLElement>('[data-share-label]');
    if (!label) return;
    let timer = 0;
    button.addEventListener('click', async () => {
      const url = `${location.origin}${location.pathname}`;
      if (navigator.share) {
        try {
          await navigator.share({ title: p.shareTitle, url });
        } catch {
          // Dismissed.
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        return;
      }
      label.textContent = p.copied;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => (label.textContent = p.share), 1800);
    });
  });
</script>
