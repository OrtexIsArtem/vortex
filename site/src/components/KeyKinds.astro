---
// The keys Vortex tells apart by their values and names to Claude (Packages/Features/Secrets/Sources/KeyKind.swift),
// as plain words: no logos.
import { copyFor } from '../copy';

const copy = copyFor(Astro.url);

const k = copy.keysChapter;
---

<div class="kinds">
  <p class="kinds__title">{k.kindsTitle}</p>
  <ul class="kinds__list">
    {k.kinds.map((kind) => <li>{kind}</li>)}
    <li class="kinds__rest">{k.kindsRest}</li>
  </ul>
</div>

<style>
  .kinds {
    max-width: 520px;
    margin-top: 26px;
  }

  .kinds__title {
    margin: 0 0 10px;
    color: var(--text-3);
    font-size: 13px;
  }

  .kinds__list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kinds__list li {
    padding: 4px 9px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--text-2);
    font: 400 12px/1.4 var(--mono);
  }

  .kinds__list .kinds__rest {
    padding-inline: 2px;
    box-shadow: none;
    color: var(--text-3);
    font-family: var(--font);
  }
</style>
