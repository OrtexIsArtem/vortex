  /* A narrow scene's panel: shorter, its widget's card in a row. */
  .home:not(.is-wide) :is(.hs-search, .hs-more) {
    display: none;
  }

  .home:not(.is-wide) .hs-wcard {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 12px;
  }

  .home:not(.is-wide) .hs-wcard :global(.hs-thumb) {
    grid-row: span 3;
  }

  .hs-pointer {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    opacity: 0;
    pointer-events: none;
    transform: translate(var(--px, 0px), var(--py, 0px));
    transition:
      transform 560ms var(--ease-in-out),
      opacity 200ms linear;
  }

  .hs-pointer.is-shown {
    opacity: 1;
  }

  .hs-pointer.is-tracking {
    transition: opacity 200ms linear;
  }

  /* Pause while the demo goes round by itself, Again once it rests; its room is kept, so showing it moves nothing. */
  .hs-again {
    visibility: hidden;
    justify-self: center;
    padding: 4px 10px;
    border-radius: 999px;
    color: var(--text-3);
    font: 400 12px/1 var(--mono);
  }

  .hs-again.is-shown {
    visibility: visible;
  }

  .hs-again:hover {
    color: var(--text-1);
  }

  @media (pointer: coarse) {
    /* A fingertip gets more than the scaled window gives: the small round buttons take taps from around them too. */
    .hs-window :global(.orb)::after,
    .hs-remove::after {
