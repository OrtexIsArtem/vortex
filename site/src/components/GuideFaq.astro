---
// A guide's own questions, under its text, as the landing's are: one per row, the answer under it. The same answers
// go to search engines in the guide's structured data (lib/structured.ts).
import { copyFor } from '../copy';
import { inlineHtml } from '../lib/inline';

interface Props {
  items: readonly { q: string; a: string }[];
}

const { items } = Astro.props;
const copy = copyFor(Astro.url);
---

<section class="faq" id="faq" aria-labelledby="faq-title">
  <h2 class="faq__title" id="faq-title">{copy.guides.questions}</h2>
  <div class="faq__list">
    {
      items.map((item) => (
        <details class="faq__item">
          <summary>
            <h3>{item.q}</h3>
          </summary>
          <p class="faq__answer rich" set:html={inlineHtml(item.a)} />
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    margin-top: 4.5em;
  }

  .faq__title {
    margin: 0 0 18px;
    font: 600 clamp(24px, 2.3vw, 30px) / 1.2 var(--font-display);
    letter-spacing: -0.022em;
  }

  .faq__item {
    box-shadow: inset 0 var(--hair) 0 var(--line);
  }

  .faq__item:last-child {
    box-shadow:
      inset 0 var(--hair) 0 var(--line),
      inset 0 calc(var(--hair) * -1) 0 var(--line);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 60px;
    padding: 14px 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  /* The marker is drawn, not read (the first `content` is for browsers without alt text for generated content). */
  .faq__item summary::after {
    content: '+';
    content: '+' / '';
    flex: none;
    color: var(--text-3);
    font: 400 18px/1 var(--mono);
    transition: color 200ms linear;
  }

  .faq__item[open] summary::after {
    content: '−';
    content: '−' / '';
  }

  .faq__item summary:hover::after {
    color: var(--text-1);
  }

  .faq__item h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .faq__answer {
    margin: 0;
    padding: 0 40px 22px 0;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  @media (max-width: 599px) {
    .faq__item h3 {
      font-size: 16px;
    }

    .faq__answer {
      padding-right: 0;
      font-size: 15.5px;
    }
  }
</style>
