---
// The Vortex spiral: the app's menu bar icon (VortexGlyph.swift), five quarter arcs in a 24 × 24 box.
interface Props {
  size?: number;
  class?: string;
}

const { size = 18, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="-0.75 -0.75 24 24" fill="none" aria-hidden="true">
  <path
    d="M12 12A1.5 1.5 0 0 1 13.5 10.5A3 3 0 0 1 16.5 13.5A4.5 4.5 0 0 1 12 18A6 6 0 0 1 6 12A7.5 7.5 0 0 1 13.5 4.5"
    stroke="currentColor"
    stroke-width="2.1"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
