---
// Offline by design, as the README's Privacy says: the facts beside a drawing of a Mac whose lines to the internet are
// cut. The one link that stays, Claude Code to Vortex on 127.0.0.1, is inside the Mac.
import { copyFor } from '../copy';
import { headingGap } from '../copy/locales';
import { inlineHtml } from '../lib/inline';

const copy = copyFor(Astro.url);
const gap = headingGap(Astro.url.pathname);

const p = copy.privacy;
const f = p.figure;
const lines = [76, 110, 144];
---

<section class="section privacy" id="privacy" aria-labelledby="privacy-title">
  <div class="container privacy__grid">
    <div class="privacy__copy" data-reveal>
      <h2 class="h2" id="privacy-title">{p.title}{gap}<span>{p.titleQuiet}</span></h2>
      <p class="lead">{p.body}</p>
      <dl class="privacy__facts">
        {
          p.facts.map((fact) => (
            <div class="privacy__fact">
              <dt>{fact.label}</dt>
              <dd class="rich" set:html={inlineHtml(fact.text)} />
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="privacy__figure" data-reveal="later" data-privacy-figure>
      <svg viewBox="0 0 560 236" role="img" aria-labelledby="privacy-figure">
        <title id="privacy-figure">{f.label}</title>
        <g class="pf-mac">
          <rect class="pf-screen" x="20" y="40" width="210" height="140" rx="12"></rect>
          <path class="pf-notch" d="M107 40h36v6a5 5 0 0 1-5 5h-26a5 5 0 0 1-5-5z"></path>
          <rect class="pf-base" x="6" y="184" width="238" height="9" rx="4.5"></rect>
          <rect class="pf-chip" x="70" y="70" width="110" height="26" rx="13"></rect>
          <text class="pf-chip-text" x="125" y="84">{f.claude}</text>
          <path class="pf-local" d="M125 96v32"></path>
          <text class="pf-small" x="133" y="116">{f.local}</text>
          <rect class="pf-chip" x="70" y="128" width="110" height="26" rx="13"></rect>
          <text class="pf-chip-text" x="125" y="142">{f.vortex}</text>
          <text class="pf-label" x="125" y="220">{f.mac}</text>
        </g>
        {
          lines.map((y, index) => (
            <g class="pf-line">
              <text class="pf-small" x="252" y={y - 9}>
                {f.blocked[index]}
              </text>
              {/* The cut sits far enough out for the longest label (Ukrainian) to end before it. */}
              <path class="pf-out" d={`M244 ${y}H375`} />
              <path class="pf-cut" d={`M380 ${y - 5}l10 10m0-10-10 10`} />
              <path class="pf-dead" d={`M395 ${y}H440`} />
            </g>
          ))
        }
        <g class="pf-internet">
          <circle cx="486" cy="110" r="42"></circle>
          <path d="M444 110h84"></path>
          <ellipse cx="486" cy="110" rx="17" ry="42"></ellipse>
          <text class="pf-label" x="486" y="176">{f.internet}</text>
        </g>
      </svg>
    </figure>
  </div>
</section>

<style>
  .privacy__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    gap: 56px var(--gutter);
  }

  .privacy__copy {
    grid-column: 1 / span 6;
  }

  .privacy__figure {
    grid-column: 7 / span 6;
    margin: 0;
  }

  .privacy__facts {
    max-width: 560px;
    margin: 30px 0 0;
  }

  .privacy__fact {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 16px;
    padding: 13px 0;
    box-shadow: inset 0 var(--hair) 0 var(--line);
  }

  .privacy__fact:last-child {
    box-shadow:
      inset 0 var(--hair) 0 var(--line),
      inset 0 calc(var(--hair) * -1) 0 var(--line);
  }

  .privacy__fact dt {
    color: var(--text-3);
    font: 12.5px/1.6 var(--mono);
  }

  .privacy__fact dd {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.5;
  }

  .privacy__figure svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .pf-screen {
    fill: var(--window);
    stroke: var(--track);
  }

  .pf-notch {
    fill: var(--notch);
  }

  .pf-base,
  .pf-internet circle,
  .pf-internet path,
  .pf-internet ellipse {
    fill: none;
    stroke: var(--track);
  }

  .pf-chip {
    fill: var(--surface);
    stroke: rgb(255 255 255 / 0.14);
  }

  .pf-chip-text {
    fill: var(--text-1);
    font: 11px var(--mono);
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .pf-local {
    stroke: var(--text-2);
  }

  .pf-small {
    fill: var(--text-3);
    font: 10.5px var(--mono);
  }

  .pf-label {
    fill: var(--text-2);
    font: 11.5px var(--mono);
    text-anchor: middle;
  }

  .pf-out,
  .pf-dead {
    fill: none;
    stroke-width: 1.2;
    stroke-dasharray: 3 5;
  }

  .pf-out {
    stroke: var(--text-2);
  }

  .pf-dead {
    stroke: var(--track);
  }

  .pf-cut {
    fill: none;
    stroke: var(--text-1);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  /* When it comes into view, the dashes run towards the internet for a few seconds and stop at the cut; nothing on
     the page moves by itself for long. */
  @media (prefers-reduced-motion: no-preference) {
    .privacy__figure.is-live .pf-out {
      animation: pf-flow 1.1s linear 4;
    }
  }

  @keyframes pf-flow {
    to {
      stroke-dashoffset: -8;
    }
  }

  @media (max-width: 1023px) {
    .privacy__copy,
    .privacy__figure {
      grid-column: 1 / -1;
    }

    .privacy__figure {
      max-width: 620px;
    }
  }

  /* On a phone the drawing's labels would be too small to read; the facts above say the same. */
  @media (max-width: 599px) {
    .privacy__fact {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }

    .privacy__figure {
      display: none;
    }
  }
</style>

<script>
  const figure = document.querySelector<HTMLElement>('[data-privacy-figure]');
  if (figure) {
    new IntersectionObserver(([entry]) => figure.classList.toggle('is-live', entry?.isIntersecting ?? false)).observe(figure);
  }
</script>
