---
// The app's "Time's up" notification, drawn as a macOS banner under the menu bar.
import { copyFor } from '../copy';
import { appLangOf, localeOf } from '../copy/locales';
import Glyph from './Glyph.astro';
import Icon from './Icon.astro';

const copy = copyFor(Astro.url);

const t = copy.timer;
const appLang = appLangOf(localeOf(Astro.url.pathname));
---

<span class="visually-hidden" aria-live="polite" data-timer-status></span>
<div class="toast" data-toast role="status" aria-live="polite" hidden data-nosnippet lang={appLang}>
  <span class="toast__icon" aria-hidden="true"><Glyph size={20} /></span>
  <div class="toast__text">
    <p class="toast__app">{t.app}</p>
    <p class="toast__title">{t.timesUp}</p>
  </div>
  <button class="toast__more" type="button" data-toast-more>{t.more}</button>
  <button class="toast__close" type="button" data-toast-close aria-label={t.dismiss}>
    <Icon name="close" size={12} />
  </button>
</div>

<style>
  .toast {
    position: fixed;
    top: calc(var(--menubar-h) + 10px);
    right: 12px;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(360px, calc(100vw - 24px));
    padding: 12px 12px 12px 14px;
    border-radius: 20px;
    background: rgb(36 36 40 / 0.82);
    -webkit-backdrop-filter: saturate(180%) blur(28px);
    backdrop-filter: saturate(180%) blur(28px);
    box-shadow:
      0 0 0 var(--hair) rgb(255 255 255 / 0.12),
      0 20px 50px rgb(0 0 0 / 0.5);
    transform: translateX(calc(100% + 24px));
    transition: transform 520ms var(--ease-out);
  }

  .toast.is-shown {
    transform: none;
  }

  .toast__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: #000;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  .toast__text {
    flex: 1;
    min-width: 0;
  }

  .toast__text p {
    margin: 0;
    line-height: 1.3;
  }

  .toast__app {
    color: var(--text-2);
    font-size: 12px;
  }

  .toast__title {
    font-size: 14px;
    font-weight: 600;
  }

  .toast__more {
    height: 30px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
  }

  .toast__close {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    color: var(--text-2);
  }

  .toast__close:hover {
    background: rgb(255 255 255 / 0.08);
    color: var(--text-1);
  }

  /* On touch screens the close button takes a finger's width beyond its circle. */
  @media (pointer: coarse) {
    .toast__close {
      position: relative;
    }

    .toast__close::after {
      content: '';
      position: absolute;
      inset: -9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toast {
      transform: none;
      opacity: 0;
      transition: opacity 200ms linear;
    }

    .toast.is-shown {
      opacity: 1;
    }
  }
</style>
