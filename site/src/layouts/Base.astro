---
import '../styles/tokens.css';
import '../styles/global.css';
import { copyFor } from '../copy';
import { basePath, defaultLocale, localeByCode, localeOf, locales, urlFor } from '../copy/locales';
import { appVersion, downloadUrl, licenseUrl, repoUrl } from '../lib/app';
import type { Alternate } from '../lib/pages';
import { fromSearch, pickLocale } from '../lib/pick-locale';
import { landingGraph, serializeGraph } from '../lib/structured';

interface Props {
  title: string;
  description: string;
  /** A guide's own head (lib/pages.ts). Left out, the page is the landing in its language: every language's landing as
   * its translations, the intro that lights up the notch, and at the root the language detection. */
  guide?: {
    /** The page's address, and its versions in the languages it exists in, all absolute once the site's address is
     * known; `xDefault` is the English one. */
    canonical: string;
    alternates: readonly Alternate[];
    xDefault: string;
    published: Date;
    modified: Date;
    /** What search engines read about it (lib/structured.ts). */
    graph: readonly object[];
  };
}

const { title, description, guide } = Astro.props;
const code = localeOf(Astro.url.pathname);
const locale = localeByCode(code);
const copy = copyFor(Astro.url);

const home = urlFor(defaultLocale, Astro.site);
const page = guide?.canonical ?? urlFor(code, Astro.site);
const alternates = guide?.alternates ?? locales.map((other) => ({ code: other.code, href: urlFor(other.code, Astro.site) }));
const xDefault = guide?.xDefault ?? home;
const image = Astro.site ? new URL(`${basePath}og.png`, Astro.site).href : `${basePath}og.png`;

const structured = serializeGraph(
  guide?.graph ??
    landingGraph({
      home,
      page,
      title,
      description,
      tag: locale.tag,
      tags: locales.map((l) => l.tag),
      image,
      appVersion,
      downloadUrl,
      licenseUrl,
      repoUrl,
    }),
);

// The root page sends a visitor arriving from elsewhere to their language: one they picked on this site before, or the
// first their browser asks for that the site has. Moving around the site never redirects, and the other languages'
// pages never move anyone, nor do the guides. Search engines pick the page's language for each search themselves
// (hreflang), so a visitor from search results stays unless they picked a language here before; crawlers always stay.
const detect =
  !guide && code === defaultLocale
    ? `(function () {
  try {
    var codes = ${JSON.stringify(locales.map((locale) => locale.code))};
    var from = document.referrer;
    if (from && new URL(from).origin === location.origin) return;
    var saved = null;
    try { saved = localStorage.getItem('vortex-locale'); } catch (error) {}
    if (saved && codes.indexOf(saved) < 0) saved = null;
    if (!saved && (/bot|crawl|spider|slurp/i.test(navigator.userAgent) || (from && (${fromSearch.toString()})(from)))) return;
    var asked = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
    var code = saved || (${pickLocale.toString()})(asked, codes, ${JSON.stringify(defaultLocale)});
    if (code !== ${JSON.stringify(defaultLocale)}) location.replace(${JSON.stringify(basePath)} + code + '/' + location.search + location.hash);
  } catch (error) {}
})();`
    : null;

// The landing's intro hides what it reveals, the menu bar among them, until the notch lights up. A guide has no intro:
// its menu bar shows at once.
const intro = guide
  ? null
  : `
      // Lets the intro hide what it reveals; if a script fails, everything shows after a few seconds anyway.
      document.documentElement.classList.add('js');
      (function () {
        function arm() {
          setTimeout(function () {
            document.documentElement.classList.add('intro-done');
          }, 4000);
        }
        if (document.visibilityState === 'visible') arm();
        else document.addEventListener('visibilitychange', arm, { once: true });
      })();
    `;
---

<!doctype html>
<html lang={locale.tag} data-locale={code}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {detect && <script is:inline set:html={detect} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={page} />
    {alternates.map((other) => <link rel="alternate" hreflang={localeByCode(other.code).tag} href={other.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <meta property="og:type" content={guide ? 'article' : 'website'} />
    <meta property="og:site_name" content="Vortex" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={page} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.meta.imageAlt} />
    <meta property="og:locale" content={locale.og} />
    {
      alternates
        .filter((other) => other.code !== code)
        .map((other) => <meta property="og:locale:alternate" content={localeByCode(other.code).og} />)
    }
    {guide && <meta property="article:published_time" content={guide.published.toISOString()} />}
    {guide && <meta property="article:modified_time" content={guide.modified.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={copy.meta.imageAlt} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${basePath}favicon-64.png`} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={`${basePath}apple-touch-icon.png`} />
    <script type="application/ld+json" set:html={structured} />
    {intro && <script is:inline set:html={intro} />}
  </head>
  <body>
    <a class="skip" href="#main">{copy.skip}</a>
    <slot />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
